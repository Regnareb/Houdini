<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <tool name="br_shelf_separator" label=" " icon="hicon:/SVGIcons.index?MISC_tree_vline.svg">
    <script scriptType="python"><![CDATA[]]></script>
  </tool>

  <tool name="br_ui_show_preferences" label="Preferences" icon="hicon:/SVGIcons.index?SHELF_preflight.svg">
    <helpText><![CDATA[
    Show the preferences UI for the BetterHoudini tools allowing you to customize it further. If you want to set the base settings open the First Launch UI instead.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.preferences
common.preferences.show_prefs()
    ]]></script>
  </tool>

  <tool name="br_ui_show_first_launch" label="First Launch UI" icon="hicon:/SVGIcons.index?CHOP_band.svg">
    <helpText><![CDATA[
    Set the base Houdini settings and keyboard shortcuts for the BetterHoudini tools.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.preferences as prefs
prefs.show_firstlaunch(forceui=True)
    ]]></script>
  </tool>

  <tool name="br_ui_update_tools" label="Update" icon="hicon:/SVGIcons.index?BUTTONS_download.svg">
    <helpText><![CDATA[
    Update the BetterHoudini tools to the latest version.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import tools.installer
tools.installer.PackageInstaller().install(update=True)
    ]]></script>
  </tool>

  <tool name="br_ui_install_qlib" label="Install qLib" icon="$REGNAREB/images/qlib.svg">
    <helpText><![CDATA[
qLib is a digital asset library for SideFX's Houdini. It is a collection of tools designed to work flawlessly with each other and Houdini's native toolset. It is driven by (and used in) real production environments, but at the same time it fully respects and conforms to all the important Houdini concepts.

Strong emphasis on the following things:
 - Backwards-compatibility: old scenes will not break over time
 - Performance: we press for VEX/multithreading as much as possible
 - Usability: our tools try to avoid the "in-house" look-and-feel
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import tools.installer
tools.installer.QLibPackageInstaller().install()
    ]]></script>
  </tool>

  <tool name="br_ui_install_aelib" label="Install aeLib" icon="$REGNAREB/images/aelib.svg">
    <helpText><![CDATA[
A library of Digital Assets, Tools and Scripts for SideFX Houdini.


The /otls folder contains approximately 100 SOP level HDAs which are available from the 'aelib' Tab submenu. These are categorised into the following sections:

 - Creators: Geometry creation SOPs, usually not requiring input geometry
 - Deformer: Modify geometry positions
 - Modify: Involve creating or destroying points/primitives and require input geometry
 - Curves: A variety of tools acting on polyline curves
 - IO: Operations for reading or writing files to disk
 - Solvers: Simulations and feedback loops
 - Utility: General purpose tools and miscellaneous items
 - Extensions: Similar to existing Houdini or 3rd-Party SOPs but with extra functionality

 
As well as the HDA collection, Aelib includes:

 - A shelf containing macros and useful python scripts
 - Several VEX include files adding a range of new functions
 - A VEXpressions.txt file which adds presets to wrangles
 - Bundled python libraries required for a small number of SOP nodes
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import tools.installer
tools.installer.AELibPackageInstaller().install()
    ]]></script>
  </tool>

  <tool name="br_ui_viewports_colour" label="Change All Viewports Colour" icon="VIEW_layout_4">
    <helpText><![CDATA[
Change all viewports colour to cycle between the Houdini colour schemes (Ctrl+Alt+B by default).
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
      <contextNetType>DOP</contextNetType>
      <contextNetType>LOP</contextNetType>
    </toolMenuContext>
    <toolMenuContext name="cop_viewer">
      <contextNetType>COP2</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import common.sceneviewer
common.sceneviewer.switch_viewports_colorscheme()  
    ]]></script>
  </tool>

  <tool name="br_ui_viewport_colour" label="Change Current Viewport Colour" icon="BUTTONS_aovs">
    <helpText><![CDATA[
Change the viewport colour to cycle between the Houdini colour schemes (Alt+B by default). Can only be called by a shortcut as the mouse need to be over a viewport to know which one has to change colour.
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextOpType>*</contextOpType>
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
      <contextNetType>DOP</contextNetType>
      <contextNetType>LOP</contextNetType>
    </toolMenuContext>
    <toolMenuContext name="cop_viewer">
      <contextNetType>COP2</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import common.sceneviewer
try:
  common.sceneviewer.switch_viewports_colorscheme(current_viewport=True)
except AttributeError:
  hou.ui.displayMessage('This tool can only be called through the keyboard shortcut when the mouse is over a viewport.')
]]></script>
  </tool>

  <tool name="br_scrub_timeline" label="Scrub Timeline" icon="COP2_timefilter">
    <helpText><![CDATA[
Click in the viewport and drag your mouse on the right to advance in time (K by default). Go to the left to go back in the timeline.
Right click in the viewport to change some options of the tool.
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
      <contextNetType>DOP</contextNetType>
      <contextNetType>LOP</contextNetType>
    </toolMenuContext>
    <toolMenuContext name="cop_viewer">
      <contextNetType>COP2</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import toolutils
scene_viewer = hou.ui.paneTabOfType(hou.paneTabType.SceneViewer)
current_state = scene_viewer.currentState()
if current_state != 'br_scrub_timeline':
  scene_viewer.setCurrentState("br_scrub_timeline")
  toolutils.sceneViewer().runStateCommand('enter_scrubtimeline', args={'viewer_state': current_state})
]]></script>
  </tool>

  <tool name="br_create_node_preview" label="Add Preview" icon="VIEW_visualization_slice">
    <helpText><![CDATA[
Add thumbnails to the selected node in the Network pane (M by default). It renders the viewport for each node with a screenshot of the viewport and add it as a background image each time a parameter is changed.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import tools.node_preview
tools.node_preview.toggle_node_preview()
]]></script>
  </tool>

  <tool name="br_paste_object_merge" label="Paste Object Merge" icon="PLASMA_App">
    <helpText><![CDATA[
Copy several nodes then use this tool (Alt+V by default) to paste it as a Merge node with all previously copied nodes as links.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.paste_objectmerge()
]]></script>
  </tool>

  <tool name="br_paste_and_connect_to_selected" label="Paste and Connect to Selected" icon="PLASMA_App">
    <helpText><![CDATA[
Copy several nodes then use this tool (Ctrl+Shift+V by default) to paste those nodes below each selected nodes and connect the top pasted node to the selected nodes.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.paste_and_connect_to_selected()
]]></script>
  </tool>

  <tool name="br_cycle_display_flag" label="Cycle Display Flag" icon="PLASMA_App">
    <helpText><![CDATA[
The cycle display flag tool (R by default) can now cycle between several nodes and even after they got unselected.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.cycle_display_flag()
]]></script>
  </tool>

  <tool name="br_display_next_output" label="Cycle Display Output" icon="PLASMA_App">
    <helpText><![CDATA[
When the selected node has different outputs, this tool (Alt+X by default) cycles it's display output that will show in the viewports.
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.display_next_output()
]]></script>
  </tool>

  <tool name="br_toggle_dependancy_links" label="Toggle Dependancy Links" icon="PLASMA_App">
    <helpText><![CDATA[
This tool (Ctrl+D by default) will show the dependancy links between all nodes, only selected nodes or none. It's possible to change the shelf to toggle only between "None" and the mode you prefer:
- common.networkeditor.toggle_dependancy_links('1')  # use this for showing links only on selected nodes
- common.networkeditor.toggle_dependancy_links('2')  # use this for showing links on all nodes
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.toggle_dependancy_links()
]]></script>
  </tool>

  <tool name="br_connect_selected_nodes" label="Connect Selected Nodes" icon="PLASMA_App">
    <helpText><![CDATA[
Connect all selected nodes by their heights (Shift+Y by default)
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.networkeditor.connect_selected_nodes()
]]></script>
  </tool>

  <tool name="br_toggle_update_mode" label="Toggle Update Mode" icon="PLASMA_App">
    <helpText><![CDATA[
Toggle the update mode between "Manual" and "On Mouse Up/Auto Update" (F10 by default).
    ]]></helpText>
    <script scriptType="python"><![CDATA[
import common.hou_utils
common.hou_utils.toggle_update_mode()
]]></script>
  </tool>

  <tool name="br_change_particles_display" label="Cycle Particles Display" icon="TOOLS_select_groups_point">
    <helpText><![CDATA[
Cycle between particles display: Points/Pixels/Lines/Discs (Shift+D by default)
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
      <contextNetType>DOP</contextNetType>
      <contextNetType>LOP</contextNetType>
    </toolMenuContext>
    <toolMenuContext name="cop_viewer">
      <contextNetType>COP2</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import common.networkeditor
common.sceneviewer.change_particles_display()
]]></script>
  </tool>

  <toolshelf name="Regnareb" label="Regnareb">
    <memberTool name="br_ui_show_preferences"/>
    <memberTool name="br_ui_show_first_launch"/>
    <memberTool name="br_ui_update_tools"/>
    <memberTool name="br_ui_install_qlib"/>
    <memberTool name="br_ui_install_aelib"/>
    <memberTool name="br_shelf_separator"/>
    <memberTool name="br_ui_viewports_colour"/>
    <memberTool name="br_ui_viewport_colour"/>
    <memberTool name="br_scrub_timeline"/>
    <memberTool name="br_create_node_preview"/>
    <memberTool name="br_change_particles_display"/>
  </toolshelf>
</shelfDocument>
